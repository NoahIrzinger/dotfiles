# Machine-local and untracked overrides (never commit)
.shell.local
.bashrc.local
.npmrc.local
# Claude settings can contain client-specific MCPs, plugins, permissions, and
# internal marketplace paths. Keep real settings local; use a template if needed.
.claude/settings.json
.claude/settings.local.json
claude/.claude/settings.json
claude/.claude/settings.local.json
*.pem
*.keystore

# tmux plugins: TPM installs these at runtime into $TMUX_PLUGIN_MANAGER_PATH
# (~/.local/share/tmux/plugins/, outside this repo). This line only guards
# against a stray TPM clone landing in the stow package by mistake.
tmux/.config/tmux/plugins/

# active-theme palette + optional per-theme status styling, generated by `theme`
tmux/.config/tmux/theme.conf
tmux/.config/tmux/theme-style.conf
# ephemeral runtime state written by `theme`: cached tmux status-format defaults
# (for the reset/rollback path) and the `theme try` rollback pointer
tmux/.config/tmux/.status-default.conf
tmux/.config/tmux/.theme-previous

# the active theme is per-machine state (`theme set` rewrites it); tracking it
# would dirty the tree on every machine and block install.sh's auto-pull. Fresh
# installs default to `dark`.
themes/active

# nvim generated/cache
nvim/.config/nvim/.ropeproject/
nvim/.config/nvim/validation/
nvim/.config/nvim/.claude/

# OS
.DS_Store

# pi packages: installed at runtime by `pi install`; track manifests only
pi/.pi/agent/npm/node_modules/
# pi runtime/private state
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/
