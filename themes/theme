#!/usr/bin/env bash
# theme: switch the active color theme across nvim and tmux.
#
#   theme list            list available themes (* = active)
#   theme current         print the active theme name
#   theme set <name>      activate <name> (regenerates tmux + terminal palette, reloads live)
#   theme terminal [name] apply only terminal emulator foreground/background colors
#   theme next            rotate to the next theme (alphabetical)
#   theme prev            rotate to the previous theme
#   theme try <name>      experiment: snapshot the current theme, apply <name> live
#   theme back            roll back to the theme before the last `try`
#   theme refresh         fast re-apply of the active header after editing its .tmux
#   theme reset           restore the default single-row bar (undo a stuck custom header)
#   theme preview [name]  render the theme's status bar to a PNG and open it
#
# a theme is themes/<name>.theme: a `flavour=` line plus the 26 catppuccin palette
# slots as `name=hex` (no leading #). nvim and tmux both render through catppuccin,
# so a theme is just a palette swap. nvim reads the active theme at startup; tmux
# reads the generated ~/.config/tmux/theme.conf. the terminal emulator receives
# OSC 10/11/12 color updates for the current tab/window when supported (works in
# many native terminals and through WSL/Windows Terminal; tmux requires
# allow-passthrough, set in this repo's tmux.conf).
#
# a theme may also ship themes/<name>.tmux: a custom status bar (e.g. a multi-row
# header). `theme` copies it to ~/.config/tmux/theme-style.conf, which tmux.conf
# sources via a deferred run-shell after tpm so it overrides catppuccin. a custom
# header writes the multi-row `status-format` onto the live tmux server, so
# switching to a plain theme has to clear it or the old rows persist and the bar
# looks broken. `reset_status` does that on every switch; `theme reset` is manual.
set -euo pipefail

THEMES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ACTIVE_FILE="$THEMES_DIR/active"
TMUX_CONF_OUT="$HOME/.config/tmux/theme.conf"
TMUX_STYLE_OUT="$HOME/.config/tmux/theme-style.conf"
# Cached pristine tmux `status-format` defaults, used to clear a custom header's
# multi-row state when switching to a plain theme. Captured on first need.
STATUS_DEFAULT="$HOME/.config/tmux/.status-default.conf"
# Remembers the theme to roll back to when experimenting via `theme try`.
PREVIOUS_FILE="$HOME/.config/tmux/.theme-previous"
PI_SETTINGS="$HOME/.pi/agent/settings.json"

# palette slot (our name) -> tmux @thm_ variable suffix
SLOTS=(
  "base=bg" "text=fg"
  "rosewater=rosewater" "flamingo=flamingo" "pink=pink" "mauve=mauve"
  "red=red" "maroon=maroon" "peach=peach" "yellow=yellow" "green=green"
  "teal=teal" "sky=sky" "sapphire=sapphire" "blue=blue" "lavender=lavender"
  "subtext1=subtext_1" "subtext0=subtext_0"
  "overlay2=overlay_2" "overlay1=overlay_1" "overlay0=overlay_0"
  "surface2=surface_2" "surface1=surface_1" "surface0=surface_0"
  "mantle=mantle" "crust=crust"
)

list_themes() {
  for f in "$THEMES_DIR"/*.theme; do
    [ -e "$f" ] || continue
    basename "$f" .theme
  done
}

active_name() { [ -f "$ACTIVE_FILE" ] && tr -d '[:space:]' < "$ACTIVE_FILE" || echo ""; }

slot_var() {  # $1 = palette slot name -> @thm_ variable suffix (empty if not a known slot)
  local pair
  for pair in "${SLOTS[@]}"; do
    [ "${pair%%=*}" = "$1" ] && { printf '%s' "${pair#*=}"; return; }
  done
}

theme_slot() {  # $1 = .theme file, $2 = slot name -> six hex digits
  local file="$1" want="$2" line key val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    key="${key//[[:space:]]/}"; val="${val//[[:space:]]/}"
    [ "$key" = "$want" ] || continue
    case "$val" in *[!0-9a-fA-F]*|"") return 1 ;; esac
    [ "${#val}" -eq 6 ] || return 1
    printf '%s' "$val"
    return 0
  done < "$file"
  return 1
}

terminal_osc_payload() {  # $1 = .theme file -> OSC fg/bg/cursor sequences
  local file="$1" fg bg cursor
  fg="$(theme_slot "$file" text || true)"
  bg="$(theme_slot "$file" base || true)"
  cursor="$(theme_slot "$file" peach || true)"
  [ -n "$fg" ] && [ -n "$bg" ] || return 0
  [ -n "$cursor" ] || cursor="$fg"
  # OSC 10 = foreground, 11 = background, 12 = cursor. Supported by iTerm2,
  # kitty, WezTerm, many xterm-compatible terminals, and current Windows Terminal.
  printf '\033]10;#%s\007\033]11;#%s\007\033]12;#%s\007' "$fg" "$bg" "$cursor"
}

apply_terminal() {  # $1 = .theme file; current terminal tab/window only
  # Only emit escape sequences when invoked from an interactive terminal/tmux pane.
  [ -t 1 ] || return 0
  local payload esc
  payload="$(terminal_osc_payload "$1")"
  [ -n "$payload" ] || return 0
  if [ -n "${TMUX:-}" ]; then
    # tmux passthrough DCS; inner ESC bytes must be doubled for tmux.
    esc=$'\033'
    payload="${payload//$esc/$esc$esc}"
    printf '\033Ptmux;\033%s\033\\' "$payload"
  else
    printf '%s' "$payload"
  fi
}

pi_theme_for() {  # $1 = theme name -> pi theme name
  case "$1" in
    light) echo "dotfiles-light" ;;
    *)     echo "dotfiles-dark" ;;
  esac
}

update_pi_theme() {  # $1 = theme name; best-effort update of pi settings.json
  local pi_theme; pi_theme="$(pi_theme_for "$1")"
  [ -f "$PI_SETTINGS" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  PI_SETTINGS="$PI_SETTINGS" PI_THEME="$pi_theme" python3 - <<'PY' >/dev/null 2>&1 || true
import json, os
path = os.environ["PI_SETTINGS"]
theme = os.environ["PI_THEME"]
with open(path) as f:
    data = json.load(f)
data["theme"] = theme
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
}

gen_tmux() {  # $1 = .theme file; $2 = output path (default $TMUX_CONF_OUT)
  # parse the .theme as data (name=value); never source it (that's code exec from
  # an untrusted file). each line is flavour=<word> or <slot>=<6 hex>; else ignored.
  local out="${2:-$TMUX_CONF_OUT}" file="$1"
  mkdir -p "$(dirname "$out")"
  local flavour="mocha" line key val var
  {
    echo "# generated by \`theme set\`; edit themes/$(basename "$file"), not this file."
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"                 # strip comments
      case "$line" in *=*) ;; *) continue ;; esac
      key="${line%%=*}"; val="${line#*=}"
      key="${key//[[:space:]]/}"; val="${val//[[:space:]]/}"
      if [ "$key" = flavour ]; then
        case "$val" in [a-z]*[!a-z]*|"") ;; [a-z]*) flavour="$val" ;; esac
        continue
      fi
      case "$val" in *[!0-9a-fA-F]*|"") continue ;; esac   # hex only
      [ "${#val}" -eq 6 ] || continue                       # exactly 6 digits
      var="$(slot_var "$key")"                              # ignore unknown slot names
      [ -n "$var" ] && echo "set -g @thm_${var} '#${val}'"
    done < "$file"
    echo "set -g @catppuccin_flavor '${flavour}'"
  } > "$out"
}

gen_style() {  # $1 = theme name -> writes $TMUX_STYLE_OUT (optional per-theme tmux styling)
  mkdir -p "$(dirname "$TMUX_STYLE_OUT")"
  local src="$THEMES_DIR/$1.tmux"
  if [ -f "$src" ]; then
    cp "$src" "$TMUX_STYLE_OUT"
  else
    : > "$TMUX_STYLE_OUT"   # empty -> default catppuccin status bar
  fi
}

gen_status_default() {  # capture pristine tmux status-format defaults into $STATUS_DEFAULT
  command -v tmux >/dev/null 2>&1 || return 1
  local sock="themedef-$$" i
  # a throwaway server with an empty config exposes the built-in defaults
  tmux -L "$sock" -f /dev/null new-session -d >/dev/null 2>&1 || return 1
  {
    echo "# pristine tmux status-format defaults, captured by \`theme\`. Sourced to"
    echo "# clear a custom header's multi-row state. Regenerated if deleted."
    echo "set -g status on"
    for i in 0 1; do
      # show-options prints a re-sourceable, correctly-quoted value
      printf "set -g 'status-format[%s]' %s\n" "$i" \
        "$(tmux -L "$sock" show-options -g "status-format[$i]" | sed "s/^status-format\[$i\] //")"
    done
    for i in 2 3 4; do echo "set -gu 'status-format[$i]'"; done
  } > "$STATUS_DEFAULT"
  tmux -L "$sock" kill-server >/dev/null 2>&1 || true
}

reset_status() {  # restore the single-row baseline on the live server (clears any custom header)
  command -v tmux >/dev/null 2>&1 || return 0
  tmux list-sessions >/dev/null 2>&1 || return 0   # nothing live to reset
  [ -f "$STATUS_DEFAULT" ] || gen_status_default || return 0
  tmux source-file "$STATUS_DEFAULT" >/dev/null 2>&1 || true
}

reload_tmux() {
  command -v tmux >/dev/null 2>&1 || return 0
  tmux list-sessions >/dev/null 2>&1 || return 0   # no server running
  reset_status                                     # clear any prior theme's custom header first
  tmux source-file "$HOME/.config/tmux/tmux.conf" >/dev/null 2>&1 || true
  return 0
}

reload_nvim() {  # best-effort live reload of any nvim listening on a socket
  command -v nvim >/dev/null 2>&1 || return 0
  local sock
  for sock in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*.0 /tmp/nvim*/*.0; do
    [ -S "$sock" ] || continue
    nvim --server "$sock" --remote-send '<C-\><C-N>:ThemeReload<CR>' >/dev/null 2>&1 || true
  done
  return 0
}

cmd_set() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "usage: theme set <name>" >&2; exit 1; }
  local file="$THEMES_DIR/$name.theme"
  if [ ! -f "$file" ]; then
    echo "no such theme: $name" >&2
    echo "available: $(list_themes | paste -sd' ' -)" >&2
    exit 1
  fi
  echo "$name" > "$ACTIVE_FILE"
  gen_tmux "$file"
  gen_style "$name"
  reload_tmux
  apply_terminal "$file"
  update_pi_theme "$name"
  reload_nvim
  echo "theme -> $name"
  echo "  tmux: palette regenerated$(tmux list-sessions >/dev/null 2>&1 && echo ' + reloaded live' || true)"
  echo "  nvim: applies on next launch (or :ThemeReload in a running instance)"
  echo "  pi: settings theme -> $(pi_theme_for "$name") (restart pi or /reload if already running)"
}

cmd_terminal() {  # apply terminal emulator colors without changing active theme
  local name="${1:-$(active_name)}"
  [ -n "$name" ] || { echo "usage: theme terminal <name>" >&2; exit 1; }
  local file="$THEMES_DIR/$name.theme"
  [ -f "$file" ] || { echo "no such theme: $name" >&2; exit 1; }
  apply_terminal "$file"
  echo "terminal colors -> $name"
}

cmd_preview() {  # render a theme's status bar to a PNG (design tool for custom headers)
  local name="${1:-$(active_name)}"
  [ -n "$name" ] || { echo "usage: theme preview <name>" >&2; exit 1; }
  [ -f "$THEMES_DIR/$name.theme" ] || { echo "no such theme: $name" >&2; exit 1; }
  command -v python3 >/dev/null 2>&1 || { echo "preview needs python3 (+ pyte, pillow)" >&2; exit 1; }
  local tmp pal conf png
  tmp="$(mktemp -d)"; pal="$tmp/palette.conf"; conf="$tmp/preview.conf"; png="$tmp/$name.png"
  gen_tmux "$THEMES_DIR/$name.theme" "$pal"
  {
    echo "source-file -q $pal"
    if [ -f "$THEMES_DIR/$name.tmux" ]; then
      echo "source-file -q $THEMES_DIR/$name.tmux"
    else
      echo "# $name ships no custom header (.tmux); it uses the default catppuccin bar."
    fi
  } > "$conf"
  python3 "$THEMES_DIR/_preview.py" "$conf" "$png" || { echo "preview failed" >&2; exit 1; }
  echo "preview -> $png"
  command -v open >/dev/null 2>&1 && open "$png" || true
}

cmd_try() {  # experiment: snapshot the current theme, then apply <name> live
  local name="${1:-}" cur
  [ -n "$name" ] || { echo "usage: theme try <name>" >&2; exit 1; }
  [ -f "$THEMES_DIR/$name.theme" ] || { echo "no such theme: $name" >&2; exit 1; }
  cur="$(active_name)"
  # only snapshot when actually changing themes, so re-trying the same scratch
  # theme (after editing it) keeps the real rollback target intact.
  if [ -n "$cur" ] && [ "$cur" != "$name" ]; then echo "$cur" > "$PREVIOUS_FILE"; fi
  cmd_set "$name"
  echo "  rollback: theme back -> ${cur:-$(cat "$PREVIOUS_FILE" 2>/dev/null || echo '?')}"
}

cmd_back() {  # roll back to the theme remembered by the last `theme try`
  local prev; prev="$(cat "$PREVIOUS_FILE" 2>/dev/null || true)"
  [ -n "$prev" ] || { echo "no previous theme to roll back to (use: theme try <name>)" >&2; exit 1; }
  [ -f "$THEMES_DIR/$prev.theme" ] || { echo "previous theme '$prev' no longer exists" >&2; exit 1; }
  cmd_set "$prev"
  echo "  rolled back to $prev"
}

cmd_refresh() {  # fast re-apply of the active theme's custom header after editing its .tmux
  local cur; cur="$(active_name)"
  [ -n "$cur" ] || { echo "no active theme" >&2; exit 1; }
  gen_style "$cur"                       # re-copy themes/<cur>.tmux -> theme-style.conf
  if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
    reset_status                         # clear the previous header's rows
    tmux source-file -q "$TMUX_STYLE_OUT" >/dev/null 2>&1 || true
  fi
  echo "refreshed header for $cur (no full reload)"
}

cmd_rotate() {  # $1 = next|prev
  local cur n idx i line
  local themes=()
  cur="$(active_name)"
  while IFS= read -r line; do themes+=("$line"); done < <(list_themes | sort)
  n=${#themes[@]}
  [ "$n" -gt 0 ] || { echo "no themes found in $THEMES_DIR" >&2; exit 1; }
  idx=0
  for i in "${!themes[@]}"; do [ "${themes[$i]}" = "$cur" ] && idx=$i; done
  if [ "$1" = next ]; then idx=$(( (idx + 1) % n )); else idx=$(( (idx - 1 + n) % n )); fi
  cmd_set "${themes[$idx]}"
}

case "${1:-list}" in
  list|ls)
    cur="$(active_name)"
    while IFS= read -r t; do
      [ "$t" = "$cur" ] && echo "* $t" || echo "  $t"
    done < <(list_themes | sort)
    ;;
  current|active) active_name ;;
  set|use) shift; cmd_set "${1:-}" ;;
  terminal|term) shift; cmd_terminal "${1:-}" ;;
  next)    cmd_rotate next ;;
  prev|previous) cmd_rotate prev ;;
  try)     shift; cmd_try "${1:-}" ;;
  back|rollback) cmd_back ;;
  refresh) cmd_refresh ;;
  reset)   reset_status; echo "status bar reset to the default single-row catppuccin bar" ;;
  preview) shift; cmd_preview "${1:-}" ;;
  -h|--help|help)
    # print the leading comment block (everything before `set -euo pipefail`)
    sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
    ;;
  *) echo "unknown command: $1 (try: theme help)" >&2; exit 1 ;;
esac
